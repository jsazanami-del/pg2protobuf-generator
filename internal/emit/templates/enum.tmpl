{{- if .Comment -}}
// {{.Comment}}
{{end -}}
enum {{.Name}} {
{{- range .Values}}
{{- if .Comment}}
  // {{.Comment}}
{{- end}}
  {{.Name}} = {{.Number}};
{{- end}}
{{- if .ReservedNumbers}}
  reserved {{range $i, $n := .ReservedNumbers}}{{if $i}}, {{end}}{{$n}}{{end}};
{{- end}}
{{- if .ReservedNames}}
  reserved {{range $i, $n := .ReservedNames}}{{if $i}}, {{end}}"{{$n}}"{{end}};
{{- end}}
}
